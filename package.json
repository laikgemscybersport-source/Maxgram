{
  "name": "maxgram",
  "version": "1.0.0",
  "description": "Telegram-style messenger",
  "main": "electron/main.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "test": "node test.js",
    "client": "cd client && npm run dev",
    "build:client": "cd client && npm install && npm run build",
    "icon": "node tools/gen-icon.js",
    "desktop": "electron .",
    "dist": "npm run build:client && electron-builder --win"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "multer": "^2.5.0",
    "uuid": "^9.0.0",
    "ws": "^8.16.0"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "electron": "^45.1.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "ru.maxgram.app",
    "productName": "MAXgram",
    "directories": {
      "output": "desktop",
      "buildResources": "electron/build"
    },
    "files": [
      "server.js",
      "config.js",
      "package.json",
      "electron/**/*",
      "client/dist/**/*",
      "!electron/build/*.png",
      "!**/{.git,.github,docs,examples,test,tests}/**"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "electron/build/icon.ico",
      "artifactName": "MAXgram-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MAXgram",
      "artifactName": "MAXgram-Setup-${version}.${ext}"
    }
  }
}
